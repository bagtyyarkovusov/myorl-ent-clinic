{
  "kind": "collectionType",
  "collectionName": "url_mappings",
  "info": {
    "singularName": "url-mapping",
    "pluralName": "url-mappings",
    "displayName": "UrlMapping"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "path": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "canonical",
        "redirect_301",
        "gone_410"
      ],
      "default": "canonical",
      "required": true
    },
    "isAutoGenerated": {
      "type": "boolean",
      "default": false
    },
    "page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "url_mappings"
    },
    "disease": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::disease.disease",
      "inversedBy": "url_mappings"
    },
    "disease_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::disease-category.disease-category",
      "inversedBy": "url_mappings"
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "url_mappings"
    },
    "service_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "url_mappings"
    },
    "legacyPaths": {
      "type": "json",
      "default": []
    }
  }
}
